{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://hodgeluke.com",
          "https://www.hodgeluke.com",
          "https://ingest.hodgeluke.com"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
